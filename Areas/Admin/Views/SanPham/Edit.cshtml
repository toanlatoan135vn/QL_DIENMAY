@model ql_cuahang.Models.SanPham

@{
    ViewData["Title"] = "Chỉnh sửa sản phẩm";
}

<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-warning text-dark fw-bold">CHỈNH SỬA THÔNG TIN SẢN PHẨM ĐIỆN MÁY</div>
                <div class="card-body">
                    <form asp-action="Edit" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <!-- Khóa chính ẩn để cập nhật đúng sản phẩm -->
                        <input type="hidden" asp-for="MaSP" />
                        <!-- Giữ lại hình cũ nếu không chọn hình mới -->
                        <input type="hidden" asp-for="HinhAnh" />

                        <div class="mb-3">
                            <label asp-for="TenSP" class="form-label fw-bold">Tên sản phẩm</label>
                            <input asp-for="TenSP" class="form-control" required />
                            <span asp-validation-for="TenSP" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MaLoai" class="form-label fw-bold">Loại sản phẩm</label>
                            <select asp-for="MaLoai" class="form-select" asp-items="ViewBag.MaLoai" required>
                                <option value="">-- Chọn loại điện máy --</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label asp-for="GiaBan" class="form-label fw-bold">Giá bán (VNĐ)</label>
                            <input asp-for="GiaBan" type="number" class="form-control" required />
                            <span asp-validation-for="GiaBan" class="text-danger"></span>
                        </div>

                        <!-- Hiển thị ảnh hiện tại và ô chọn file thay đổi mới -->
                        <div class="mb-3">
                            <label class="form-label fw-bold d-block">Hình ảnh hiện tại</label>
                            @if (!string.IsNullOrEmpty(Model.HinhAnh))
                            {
                                <img src="~/images/@Model.HinhAnh" class="img-thumbnail mb-2" style="width: 100px; height: 100px; object-fit: contain;" />
                            }
                            else
                            {
                                <p class="text-muted small">Chưa có hình ảnh</p>
                            }
                            <input type="file" name="fileHinh" class="form-control mt-1" />
                            <small class="text-muted">Chọn file mới nếu muốn thay thế ảnh cũ.</small>
                        </div>

                        <!-- Radio Button bắt buộc cho Tình trạng hàng -->
                        <div class="mb-3">
                            <label class="form-label fw-bold d-block">Tình trạng hàng</label>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" asp-for="TrangThai" value="true" id="trangThai1" />
                                <label class="form-check-label" for="trangThai1">Còn hàng</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" asp-for="TrangThai" value="false" id="trangThai2" />
                                <label class="form-check-label" for="trangThai2">Tạm hết hàng</label>
                            </div>
                        </div>

                        <!-- Checkbox bắt buộc cho Đặc điểm (Sản phẩm nổi bật / Trả góp 0%) -->
                        <div class="mb-4">
                            <label class="form-label fw-bold d-block">Đặc điểm / Khuyến mãi</label>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" asp-for="SanPhamNoiBat" id="chkNoiBat" />
                                <label class="form-check-label" for="chkNoiBat">
                                    Sản phẩm nổi bật (Bán chạy) / Hỗ trợ trả góp 0%
                                </label>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
                            <button type="submit" class="btn btn-warning text-white fw-bold px-4">Cập nhật thay đổi</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>