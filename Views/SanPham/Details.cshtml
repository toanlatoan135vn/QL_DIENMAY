@model ql_cuahang.Models.SanPham

@{
    ViewData["Title"] = Model.TenSP;
    var lienQuan = ViewBag.SanPhamLienQuan as IEnumerable<ql_cuahang.Models.SanPham>;
}

<div class="container my-5">
    <div class="row">
        <div class="col-md-5">
            <img src="~/images/@(string.IsNullOrEmpty(Model.HinhAnh) ? "default.png" : Model.HinhAnh)"
                 class="img-fluid rounded shadow-sm border p-3 w-100" alt="@Model.TenSP" style="max-height: 400px; object-fit: contain;">
        </div>
        <div class="col-md-7">
            <h2 class="fw-bold text-dark">@Model.TenSP</h2>
            <p class="text-muted">Loại hàng: <span class="fw-semibold text-primary">@Model.LoaiSanPham?.TenLoai</span></p>
            <h3 class="text-danger fw-bold my-3">@Model.GiaBan.ToString("N0") VNĐ</h3>

            <p>
                Tình trạng:
                @if (Model.TrangThai)
                {
                    <span class="badge bg-success">Còn hàng</span>
                }
                else
                {
                    <span class="badge bg-secondary">Tạm hết hàng</span>
                }
            </p>

            @if (Model.SanPhamNoiBat)
            {
                <div class="alert alert-warning py-2 mb-3">🔥 <strong>Đặc điểm:</strong> Sản phẩm nổi bật / Hỗ trợ trả góp 0%</div>
            }

            <hr />
            <h5 class="fw-bold mb-3">Thông số kỹ thuật</h5>
            <table class="table table-bordered table-striped">
                <tr>
                    <th style="width: 30%;">Công nghệ</th>
                    <td>Inverter tiết kiệm điện tối ưu</td>
                </tr>
                <tr>
                    <th>Bảo hành</th>
                    <td>24 Tháng chính hãng</td>
                </tr>
            </table>

            <div class="mt-4">
                <a href="#" class="btn btn-danger btn-lg px-4 me-2">Đặt mua ngay</a>
                <a asp-action="Index" class="btn btn-outline-secondary btn-lg">Quay lại danh sách</a>
            </div>
        </div>
    </div>

    <!-- 4 sản phẩm liên quan -->
    <div class="row mt-5">
        <h4 class="fw-bold mb-4 text-uppercase">Sản phẩm liên quan cùng loại</h4>
        @if (lienQuan != null && lienQuan.Any())
        {
            foreach (var sp in lienQuan)
            {
                <div class="col-md-3 mb-3">
                    <div class="card h-100 shadow-sm">
                        <img src="~/images/@(string.IsNullOrEmpty(sp.HinhAnh) ? "default.png" : sp.HinhAnh)"
                             class="card-img-top p-2" style="height: 150px; object-fit: contain;" alt="@sp.TenSP">
                        <div class="card-body d-flex flex-column">
                            <h6 class="card-title text-truncate">@sp.TenSP</h6>
                            <p class="text-danger fw-bold mb-2">@sp.GiaBan.ToString("N0") VNĐ</p>
                            <a asp-action="Details" asp-route-id="@sp.MaSP" class="btn btn-outline-dark btn-sm mt-auto">Xem chi tiết</a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <p class="text-muted">Không có sản phẩm liên quan nào khác.</p>
        }
    </div>
</div>