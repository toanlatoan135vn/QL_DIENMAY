@model IEnumerable<ql_cuahang.Models.SanPham>

@{
    ViewData["Title"] = "Trang chủ - Điện Máy Nhóm 13";
}

<div class="text-center mb-5">
    <h1 class="display-4 text-primary fw-bold">ĐIỆN MÁY NHÓM 13</h1>
    <p>Sản phẩm chính hãng, giá tốt nhất thị trường!</p>
</div>

<div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
    @if (Model != null && Model.Any())
    {
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0">
                    <!-- Ảnh tạm thời dùng link ảnh trên mạng để test -->
                    <img src="https://via.placeholder.com/300x200?text=Dien+May" class="card-img-top" alt="@item.TenSP">

                    <div class="card-body">
                        <h6 class="card-title fw-bold text-truncate" title="@item.TenSP">@item.TenSP</h6>
                        <p class="card-text text-danger fw-bold fs-5">@item.GiaBan.ToString("N0") VNĐ</p>
                    </div>

                    <div class="card-footer bg-white border-0 text-center pb-3">
                        <a href="#" class="btn btn-outline-primary w-100">Chọn mua</a>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12 text-center">
            <div class="alert alert-warning">Chưa có sản phẩm nào trong cửa hàng.</div>
        </div>
    }
</div>